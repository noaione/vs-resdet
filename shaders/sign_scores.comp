#version 460

// Calculate one complete sign-score array from the DCT coefficients. The
// caller dispatches this kernel twice: axis 0 produces width scores, and axis
// 1 produces height scores. Entries outside the meaningful range are zero,
// matching libresdet's range/bounds convention while keeping the GPU result
// directly indexable by the source coordinate.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Coefficients {
    float values[];
} coefficients;

layout(std430, set = 0, binding = 1) writeonly buffer Scores {
    float values[];
} scores;

layout(push_constant) uniform SignParameters {
    uint width;
    uint height;
    uint axis; // 0 = width, 1 = height
    uint range;
    uint output_offset;
} parameters;

uint sign_bit(float value) {
    return floatBitsToUint(value) >> 31u;
}

void main() {
    uint coordinate = gl_GlobalInvocationID.x;
    uint length = parameters.axis == 0u ? parameters.width : parameters.height;
    if (coordinate >= length) {
        return;
    }

    float score = 0.0;
    if (coordinate >= parameters.range
        && coordinate + parameters.range < length) {
        uint sign_differences = 0u;
        if (parameters.axis == 0u) {
            for (uint y = 0u; y < parameters.height; ++y) {
                uint row = y * parameters.width;
                for (uint i = 1u; i <= parameters.range; ++i) {
                    float left = coefficients.values[row + coordinate - i];
                    float right = coefficients.values[row + coordinate + i];
                    sign_differences += sign_bit(left) != sign_bit(right) ? 1u : 0u;
                }
            }
            score = float(sign_differences)
                / float(parameters.height * parameters.range);
        } else {
            for (uint x = 0u; x < parameters.width; ++x) {
                for (uint i = 1u; i <= parameters.range; ++i) {
                    float top = coefficients.values[(coordinate - i) * parameters.width + x];
                    float bottom = coefficients.values[(coordinate + i) * parameters.width + x];
                    sign_differences += sign_bit(top) != sign_bit(bottom) ? 1u : 0u;
                }
            }
            score = float(sign_differences)
                / float(parameters.width * parameters.range);
        }
    }

    scores.values[parameters.output_offset + coordinate] = score;
}
